# Copia este archivo a .env y reemplaza cada valor.
# Genera secretos con: openssl rand -base64 48

POSTGRES_PASSWORD=cambia-esta-contrasena-de-base

# Mínimo 32 caracteres aleatorios. Rotarlo invalida los JWT emitidos.
JWT_SECRET=cambia-este-secreto-jwt-de-al-menos-32-caracteres

# Mínimo 16 caracteres aleatorios.
CODIGO_PEPPER=cambia-este-pepper-de-codigos

# SMTP real: sin host la aplicación no arranca en prod.
ADAPTCODE_MAIL_HOST=smtp.example.com
ADAPTCODE_MAIL_PORT=587
ADAPTCODE_MAIL_USERNAME=
ADAPTCODE_MAIL_PASSWORD=

# Deja false en producción: los códigos se envían por correo.
SPRINGDOC_ENABLED=false
